# session-pilot dev-iteration scratch helpers (worktree-only, not for main repo)
/.dev-pomogator-*.sh
/COMMIT_MSG.txt

# Dependencies
node_modules/

# Build output
dist/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
coverage/

# Python
__pycache__/
*.pyc
*.pyo

# Temp files
*.tmp
*.temp

# dev-pomogator runtime (tools, backups)
.dev-pomogator/

# CARL runtime reports are project-local, but lazy rule bodies are source artifacts
.carl/*
!.carl/rules/
!.carl/rules/**

# scratch / e2e harness (plugin-install Docker test, logs)
.dev-pomogator-tmp/
# but DO track intentional test fixtures that live under a .dev-pomogator/ path
# (e.g. tui-test-runner user-patterns override) — otherwise fresh clones/CI fail those tests
!tests/fixtures/**/.dev-pomogator/
!tests/fixtures/**/.dev-pomogator/**

# OEM offline installers (if cached locally)
oem/*.msi
oem/*.exe
!oem/install.bat

# Windows null device artifact
nul

# .NET build artifacts
*.sln
**/obj/
**/bin/

# Environment files with secrets
.env
.env.*
!.env.example

# strong-tests JiT runtime audit log (suppression entries; per .specs/strong-tests/ NFR-S4)
.claude/logs/strong-tests-skips.jsonl
.claude/logs/

# Temp / runtime artifacts (mutation sandbox, scratch, embedded worktrees, runtime locks)
.stryker-tmp/
reports/
.dev-pomogator-tmp/
.claude/worktrees/
.claude/scheduled_tasks.lock

# specs-validator auto-generated coverage snapshots (per .specs/<slug>/validation-report.md);
# rewritten on every validate-specs run, runtime artifact, not source.
.specs/**/validation-report.md

# Per-spec test-run shards written by tools/bash-post-test/ingest.ts; rewritten wholesale
# on every suite run (~96k churned lines per run) and read by no tool — the authoritative
# evidence is .dev-pomogator/.last-test-run.ndjson + .scenario-results.ndjson, already
# ignored above. Runtime artifact, not source.
.specs/**/.test-results.ndjson

# Generated by scripts/docker-bdd.sh (P27-3 docker-cucumber path)
cucumber.docker.json

# Generated by executable skill eval runners
.claude/skills/*/evals/iterations/

# Windows env-var names that leaked into a path and became literal directories.
# `%windir%/Panther/UnattendGC/*.xml` (real Windows Setup logs) was committed in
# fec62086 this way: a tool ran with its cwd collapsed to C:\Windows, forbid-root-artifacts
# permits ANY stray root directory (.root-artifacts.yaml lists allowed FILES only), and
# auto-commit's `git add -A` swept it in. The junk then shipped to every user, because the
# marketplace serves this repo as-is ("source": "./").
%*%/
$*/

