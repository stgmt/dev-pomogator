{
  "marksman": {
    "command": "node",
    "args": [
      "-e",
      "require(require('node:path').resolve(process.env.CLAUDE_PLUGIN_ROOT || process.cwd(), 'tools', 'marksman-installer', 'launch-marksman.cjs')).main(['server'])"
    ],
    "extensionToLanguage": {
      ".md": "markdown"
    },
    "startupTimeout": 15000
  }
}
